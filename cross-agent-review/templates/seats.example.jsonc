// Seat configuration for the CLI transport (run-seat.mjs).
// Copy to <exchange-dir>/seats.jsonc and edit. Every field below was verified against
// a real invocation on 2026-09-15; see docs/DESIGN_agent-bus_2026-09-15.md sections 7a
// and 7b for the envelopes these paths were read out of.
//
// A seat qualifies for this transport if its CLI takes a prompt non-interactively and
// can resume a conversation by id. Adding one is a block here, not code.
{
  // ---------------------------------------------------------------------------
  // GPT via the Codex CLI. Verified working: reads, refuses writes, resumable.
  // ---------------------------------------------------------------------------
  "GPT": {
    "command": "codex",

    // The prompt goes on STDIN, not argv. Measured on this machine: argv dies with
    // ENAMETOOLONG at ~32,700 characters, which is about 8,000 tokens - less than one
    // round of a real exchange. `-` tells codex to read instructions from stdin.
    "promptVia": "stdin",
    "start":    ["exec", "--json", "-s", "{sandbox}", "-C", "{cwd}", "-o", "{replyFile}", "-"],

    // `exec resume` takes a NARROWER flag set than `exec`: it rejects --sandbox, --cd,
    // --add-dir, --approve-for-me and --profile. A continuation turn therefore inherits
    // the sandbox and working root from the turn that opened the thread. Do not add
    // -s or -C here; it exits 2 with "unexpected argument".
    "continue": ["exec", "resume", "{thread}", "--json", "-o", "{replyFile}", "-"],

    // Output is JSONL events. The reply is taken from the -o file rather than parsed
    // out of the stream: cleaner, and it does not break when the event schema changes.
    "outputFormat": "jsonl",
    "replyFrom":    "replyFile",
    "threadIdFrom": { "event": "thread.started",  "field": "thread_id" },
    "usageFrom":    { "event": "turn.completed",  "field": "usage" },
    // codex's events carry no count of turns on the thread, so seat_turns is recorded
    // as "-" for this seat and the divergence check does not apply. Add a seatTurnsFrom
    // { event, field } here if a later codex exposes one.

    // read-only is NOT a reading restriction. Verified 2026-09-15: under -s read-only a
    // seat read a file OUTSIDE its -C root, so -C does not contain reads and the seat
    // can read anything the user can. What read-only does buy, also verified, is that
    // writes are refused - the seat replied BLOCKED and created no file. Since Claude
    // appends the section, a seat has no reason to write anything.
    //   read-only | workspace-write | danger-full-access
    "sandbox": "read-only",

    // What the seat could reach, recorded per section so a reader can weigh a claim by
    // whether the seat could actually check it. "repo-read" means unrestricted reads.
    "grounding": "repo-read",

    "timeoutMs": 600000
  }

  ,

  // ---------------------------------------------------------------------------
  // Gemini via the Antigravity CLI. PROVEN through run-seat.mjs on ONE real review turn
  // and ONE resume, bengr machine, 2026-09-15 evening, agy 1.2.3:
  //
  //   review turn   a four-claim review of a 328-line script, exact path given, tool-using
  //                 (it read the file): ANSWERED in 2m25s wall clock, 78,198 input /
  //                 21,798 output tokens, every one of its 16 path:line citations re-read
  //                 against the file and correct, two real defects raised.
  //   resume        round 2 on the recorded thread via the continue template: 29s,
  //                 37,050 input tokens, and it quoted the round-1 instruction that was
  //                 never in the exchange file, so the conversation did resume.
  //   tool-free     "reply with exactly this token": 27s, 18,000 input tokens.
  //
  // Hence --print-timeout 300s below, not 150s: the review turn took 145s and would have
  // been cut at the old value. Expect a review turn to take minutes, to cost about 4x the
  // input tokens of a tool-free turn and to emit 100x the output (21,798 against 199, the
  // reasoning). One measurement, one machine, one file: the shape of the cost, not its
  // ceiling.
  //
  // The earlier "still in progress at the 150s print-timeout after 73,030 input tokens,
  // no section" was NOT a review turn. run-seat.mjs before 64871d5 substituted every
  // placeholder except {prompt}, so agy was handed the literal string "{prompt}" as its
  // whole prompt and spent 73,030 tokens working out what it meant. Fixed in 64871d5 and
  // 738c872 with pre-flight refusals for the shape.
  // ---------------------------------------------------------------------------
  "GEMPRO": {
    "command": "agy",

    // agy takes the prompt on ARGV, not stdin (--input-format stream-json expects NDJSON,
    // which is a different invocation shape). run-seat refuses above ~30,000 characters
    // rather than letting spawn fail ENAMETOOLONG and look like an unanswered seat.
    "promptVia": "argv",
    "start":    ["-p", "{prompt}", "--output-format", "json", "--new-project", "--print-timeout", "300s"],
    "continue": ["-p", "{prompt}", "--conversation", "{thread}", "--output-format", "json", "--print-timeout", "300s"],

    // ONE envelope on stdout, not a JSONL stream. The reply is in it; there is no -o file.
    "outputFormat":  "envelope",
    "replyPath":     "response",
    "threadIdPath":  "conversation_id",
    "usagePath":     "usage",
    // A denial arrives as [{ "action": "command", "display_name": "RunCommand" }] and
    // nothing else (measured 2026-09-15 with a deliberate `echo`): the command text is
    // not in the envelope, not on stderr, not in the CLI log. The failure note can name
    // the tool, never the command, so the promptSuffix below tells the seat what is
    // allowed instead. A denied review turn cost 82,907 input tokens for nothing.
    "deniedPath":    "denied_actions",

    // The CLI's own count of turns on the conversation. Measured 2026-09-15: 1 on a
    // tool-using start, 2 after one resume, so it counts conversation turns, not model
    // steps. run-seat records it as seat_turns beside its own file_turns; when they
    // differ, a turn happened that the record never received (a kill or timeout after
    // the seat advanced its history) and the section is recorded WITH a visible warning.
    "seatTurnsPath": "num_turns",

    // The anti-wander rule, and the single biggest cost lever measured on 2026-09-15.
    // When find hits a context deadline this agent falls back to recursive list_dir and
    // burns context without bound: 195,056 input tokens for an empty reply. Telling it
    // to use exact paths took the same class of task to 27,320 tokens in 40 seconds.
    "promptSuffix": "Use the exact file paths given to you. Do NOT search or list directories to find files, and do not fall back to listing directories if a search fails - ask for the path instead. Shell commands: only git and rg are allowed headlessly (the shipped settings template); any other command is auto-denied and ends your turn with nothing recorded, so read files with your file tool and run nothing else.",

    "grounding": "repo-read",
    "timeoutMs": 360000
  }

  // THREE THINGS OUTSIDE THIS FILE make the seat work. Without them a tool-using turn
  // took >5 minutes and returned an empty reply after 195,056 input tokens:
  //  1. ~/.gemini/antigravity-cli/settings.json must exist with a permissions block.
  //     With no file the CLI runs permissions=<nil> toolPermission=request-review and
  //     auto-denies every shell command. Verified: creating it flips the startup log to
  //     permissions=&{Allow:[...]}. Use command(git) style rules - the stderr advice to
  //     add unsandboxed(...) is STALE, the binary says that rule form was removed.
  //  2. --new-project, above. Without it the CLI resumes the project's persisted model
  //     from conversation_summaries.db and ignores --model, which is how a reasoning
  //     tier got selected and span for five minutes.
  //  3. The PROMPT must give exact paths and forbid directory search. When find hits a
  //     context deadline the agent falls back to recursive list_dir and burns context
  //     without bound - that, not permissions, was the 195k tokens.
  // With all three: 40 seconds, 27,320 input tokens, correct answer.
}
