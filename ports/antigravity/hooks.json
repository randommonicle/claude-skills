{
  "hooks": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./hooks/agy-wrapper.mjs ./hooks/session-recon.mjs"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          { "type": "command", "command": "node ./hooks/agy-wrapper.mjs ./hooks/push-gate.mjs" },
          { "type": "command", "command": "node ./hooks/agy-wrapper.mjs ./hooks/sql-surgery-warn.mjs" }
        ]
      },
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          { "type": "command", "command": "node ./hooks/agy-wrapper.mjs ./hooks/schedule-cost-warn.mjs" },
          { "type": "command", "command": "node ./hooks/agy-wrapper.mjs ./hooks/migration-write-warn.mjs" },
          { "type": "command", "command": "node ./hooks/agy-wrapper.mjs ./hooks/test-write-warn.mjs" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          { "type": "command", "command": "node ./hooks/agy-wrapper.mjs ./hooks/lint-after-edit.mjs", "timeout": 20 }
        ]
      }
    ]
  }
}
